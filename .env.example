# Database MCP Server Environment Variables
# 复制此文件为 .env 并填入实际值: cp .env.example .env
# 注意：.env 已在 .gitignore 中，不会被提交到 Git
#
# 目标数据库的连接不在这里配置——它们在运行时由 AI 调用 createNamedConnection
# 工具注册（BYOK），凭据不落配置文件。本服务不需要任何 DB_* 变量即可启动。

# 服务端口
SERVER_PORT=8686

# Spring 配置 - 启用 production profile（对应 application-production.yml）
SPRING_PROFILES_ACTIVE=production

# JVM 配置
JAVA_OPTS=-Xms256m -Xmx512m -XX:+UseG1GC -XX:MaxGCPauseMillis=200

# 必填：/mcp 的 HTTP Basic 管理员密码（用户名默认 admin）。
# entropy.mcp.security.enabled 自 0.4.0 起默认为 true，不填这一项服务会直接启动失败——
# 这是刻意的，宁可起不来也不要让 /mcp 对任何能连上端口的人开放。空值等同于没填，同样会失败。
# 只认真实环境变量或 JVM -Dmcp.security.admin-password，不能写进 application*.yml。
# 确实要跑免鉴权的本地实例：改用 --entropy.mcp.security.enabled=false，别把密码留空。
MCP_SECURITY_ADMIN_PASSWORD=

# 可选：把审计日志持久化到库表时才需要（同时要配 spring.datasource.url/username）。
# 不配置时审计只写文件。
MCP_AUDIT_DB_PASSWORD=

# 可选：密文凭证的 RSA 私钥（PKCS#8，base64 或 PEM，至少 2048 位）。
# 用 CredentialSealCli keygen 生成，私钥留给服务端，公钥交给运维去封装凭证。
# 配上之后多出 createSealedConnection：调用方只传连接名 + jdbcUrl + 一段密文，
# 数据库账号口令不再作为工具入参经过模型，也不会留在对话历史里。
# 留空 = 机制关闭，服务照常启动（与不填这一行等价）。私钥只能走环境变量，别写进 application*.yml。
MCP_CREDENTIAL_PRIVATE_KEY=
