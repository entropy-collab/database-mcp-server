<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.entropy.agent</groupId>
        <artifactId>database-mcp-parent</artifactId>
        <version>0.6.0</version>
    </parent>

    <artifactId>database-mcp-infra</artifactId>
    <name>Entropy Database MCP Infrastructure</name>
    <description>基础设施层：SQL 校验与审计、连接池监控、数据访问、BYOK 连接管理</description>

    <dependencies>
        <!--
            dialect 传递带入 core，这里仍显式写出 core：infra 直接用 core 的 exception /
            domain / session，不是只借道 dialect。contract 同理：BatchInsertHelper 直接用
            SqlIdentifiers、多处直接用 ErrorCode / McpValidationException。
        -->
        <dependency>
            <groupId>com.entropy.agent</groupId>
            <artifactId>database-mcp-dialect</artifactId>
        </dependency>
        <dependency>
            <groupId>com.entropy.agent</groupId>
            <artifactId>database-mcp-core</artifactId>
        </dependency>
        <dependency>
            <groupId>com.entropy.agent</groupId>
            <artifactId>database-mcp-contract</artifactId>
        </dependency>

        <!-- JdbcTemplate + HikariCP（monitor 包直接读 HikariPoolMXBean） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jdbc</artifactId>
        </dependency>

        <!--
            SecurityConfig 住在这一层：它是 HTTP 入口的鉴权规则，不是 app 的装配细节。
            oauth2-resource-server 提供 JwtAuthenticationConverter 那一族类型。
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-oauth2-resource-server</artifactId>
        </dependency>

        <!--
            Servlet API，provided 作用域。

            SecurityConfig 里有三处直接碰 servlet 类型，都不是可以绕开的写法：
            1. CSRF 的例外判断是一个 RequestMatcher lambda（读 Authorization 头）；
            2. formLogin 的成功/失败处理器与 logout 的成功处理器都是
               (HttpServletRequest, HttpServletResponse, ...) 形态的函数式接口——它们要返回
               204/401 而不是 302，而框架没有现成的"只给状态码"实现；
            3. 入口点分流用的 MediaTypeRequestMatcher 也在同一族类型上。
            spring-boot-starter-security 不带 Servlet API（容器才带），所以必须显式声明。

            provided 而不是 compile：运行期由 tomcat-embed-core 提供（app 模块的 starter-web 带上来），
            compile 作用域会让这个 API jar 跟着 infra 进下游依赖树，出现两份同名类的风险。
        -->
        <dependency>
            <groupId>jakarta.servlet</groupId>
            <artifactId>jakarta.servlet-api</artifactId>
            <scope>provided</scope>
        </dependency>

        <!--
            只要 micrometer-core（MeterRegistry / Counter / Timer）。具体的 registry 实现是
            部署选择，留在 app；换 Prometheus 以外的后端不需要改 infra。
        -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-core</artifactId>
        </dependency>

        <dependency>
            <groupId>com.github.jsqlparser</groupId>
            <artifactId>jsqlparser</artifactId>
        </dependency>
        <dependency>
            <groupId>com.github.ben-manes.caffeine</groupId>
            <artifactId>caffeine</artifactId>
        </dependency>

        <!--
            JSpecify：Spring Framework 7 起 org.springframework.lang.@Nullable 已
            @Deprecated(since="7.0")，null 性注解统一走 JSpecify。虽然它经 spring-core 传递可见，
            但这里是直接使用，显式声明。
        -->
        <dependency>
            <groupId>org.jspecify</groupId>
            <artifactId>jspecify</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-configuration-processor</artifactId>
            <optional>true</optional>
        </dependency>

        <!--
            Facet：授权内核。工具级授权（谁能在哪条连接上做什么）落在 authz 包，判定与策略数据
            都在这里，不进 tools 层——tools 只负责在切面上问一句"放不放行"。

            facet-core 零依赖（module-info 里一个 requires 都没有），facet-store-memory 提供
            内存适配器。策略数据是配置驱动的，所以不需要 facet-store-pg —— 那个适配器要
            PostgreSQL 的 WITH RECURSIVE / ctid / 顾问锁，H2 上跑不起来。

            版本 0.1.0-c9642a1 里的 c9642a1 是 facet 仓库的 commit sha：这三个 jar 随本仓库
            分发在 libs/ 下（vendored），因为 facet 还没发布到任何公共仓库。原先写
            0.1.0-SNAPSHOT 依赖本机 mvn install，后果是只有作者那台机器能构建——CI 与任何
            clone 者都会在这里报 Could not find artifact。理由与更新方式写在根 pom 的
            <repositories> 注释里。facet 发到 Central 后把这里改成 0.1.0 并删掉 libs/ 即可。
        -->
        <dependency>
            <groupId>io.github.yaotj</groupId>
            <artifactId>facet-core</artifactId>
            <version>0.1.0-c9642a1</version>
        </dependency>
        <dependency>
            <groupId>io.github.yaotj</groupId>
            <artifactId>facet-store-memory</artifactId>
            <version>0.1.0-c9642a1</version>
        </dependency>
        <dependency>
            <groupId>io.github.yaotj</groupId>
            <artifactId>facet-dsl-rebac</artifactId>
            <version>0.1.0-c9642a1</version>
        </dependency>

        <!--
            H2 只出现在测试里：主代码对 H2 的唯一"引用"是 DialectUtils 里的驱动类名字符串，
            编译期不需要它。
        -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.google.guava</groupId>
            <artifactId>guava</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

</project>
