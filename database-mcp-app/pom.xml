<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.entropy.agent</groupId>
        <artifactId>database-mcp-parent</artifactId>
        <version>0.6.0</version>
    </parent>

    <!--
        artifactId 刻意与目录名不同：可执行 jar 的名字保持 database-mcp-server-<version>.jar，
        Docker、README 与既有部署脚本引用的都是这个名字，不因为内部模块化而改变。
    -->
    <artifactId>database-mcp-server</artifactId>
    <name>Entropy Database MCP Server (app)</name>
    <description>装配层：启动类、Spring 配置、application.yml 与 JDBC 驱动，产出可执行 jar</description>

    <properties>
        <!--
            前端构建的三个 pin。Astryx 还是 Beta，node/npm/插件三者全部钉死版本，
            理由和 src/main/frontend/package.json 里不写 ^ 是同一个：这套依赖不接受
            "构建时自动升一小版本" 这种惊喜。

            frontend.node.version 与 frontend.npm.version 必须是 nodejs.org 上真实成对的组合
            （v22.23.0 官方就是带 npm 10.9.8），随便凑一对会在 install-node-and-npm 阶段
            多下一个 npm tarball，或者拿到一个没人验证过的组合。

            frontend-maven-plugin 停在 1.15.4 而不是 2.0.x：1.x 是这套 goal 名
            （install-node-and-npm / npm）稳定多年的分支，2.0 换了最低 Maven 要求，
            升级要单独验证，不适合和一次 UI 重写混在一起做。
        -->
        <frontend-maven-plugin.version>1.15.4</frontend-maven-plugin.version>
        <frontend.node.version>v22.23.0</frontend.node.version>
        <frontend.npm.version>10.9.8</frontend.npm.version>

        <!--
            前端构建的总开关，默认<b>开</b>。

            为什么需要它：项目文档里的构建命令带 -o，而 -o 是离线。
            install-node-and-npm 要下 node，npm ci 要下 tarball，冷缓存下两者都要联网，
            于是"默认绑定 + 文档命令"直接冲突。-Dfrontend.skip=true 就是给纯 Java 改动用的逃生阀。

            这个开关刻意<b>不</b>顺带跳过测试：跳过前端之后 target/classes/static 可能是空的，
            而 WebUiStaticAssetsPresenceTest 会因此失败并打印出原因。这正是想要的行为——
            "静默产出一个 static/ 为空的 jar" 是这次改动最该防的失败形态，
            所以缺产物必须在构建期炸出来，而不是等到部署后打开页面才发现是 404。

            三条路径的实际语义（命令请加上项目约定的 mise 前缀）：
              mvn clean install                        前端跑，产物齐，测试绿
              mvn -o install -Dfrontend.skip=true      不带 clean：复用上一次的产物，离线可过
              mvn -o clean install -Dfrontend.skip=true
                                                       产物被 clean 掉又没重建，测试红（预期行为）
        -->
        <frontend.skip>false</frontend.skip>
    </properties>

    <dependencies>
        <dependency>
            <groupId>com.entropy.agent</groupId>
            <artifactId>database-mcp-tools</artifactId>
        </dependency>

        <!-- 工具暴露测试夹具（SampleTools / FixedObjectProvider） -->
        <dependency>
            <groupId>com.entropy.agent</groupId>
            <artifactId>database-mcp-tools</artifactId>
            <type>test-jar</type>
            <scope>test</scope>
        </dependency>

        <!-- JSpecify null 性注解，见 infra 的同名依赖说明 -->
        <dependency>
            <groupId>org.jspecify</groupId>
            <artifactId>jspecify</artifactId>
        </dependency>

        <!--
            可观测性的"出口"选择留在 app：infra 只依赖 micrometer-core 打点，换后端不需要
            改下层模块。actuator 端点同理，是部署形态而非能力。
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
        </dependency>

        <!--
            H2 是 runtime 而不是 test：application-test.yml 是随包发布的运行 profile，
            配 dialect=h2 + test-data.enabled=true 由 TestDataInitializer 建样例库，
            所以 H2 必须在可执行 jar 的运行期 classpath 上。

            它也是唯一不受 -Ddrivers 影响的驱动，见下方 profiles。
        -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>runtime</scope>
        </dependency>
    </dependencies>

    <!--
        JDBC 驱动按 -Ddrivers 选装。驱动只在运行期 classpath 上，Hikari 通过
        java.sql.Driver 的 SPI 找它，所以增删驱动对编译零影响——这也是为什么这件事用
        profile 就够了，不需要拆模块（方言类只有几 KB，拆出去省不下镜像）。

        实测各驱动在 fat jar 里的体积（0.1.4）：
          sqlite-jdbc 11.4MB（含全平台原生库）· ojdbc11 7.4 + orai18n 1.6 · jcc 6.3
          mysql 2.5 · mssql 1.5 · postgresql 1.2 · h2 2.6      合计 34.5MB

        用法：
          mvn clean package                      全部驱动（默认，与历史行为一致）  86.2MB
          mvn clean package -Ddrivers=oss        去掉 Oracle/SQL Server/DB2        69.4MB
          mvn clean package -Ddrivers=minimal    只留 PostgreSQL/MySQL             57.9MB
          mvn clean package -Ddrivers=none       只留 H2，驱动由部署方外挂         54.1MB

        必须带 clean。不带的话 maven-jar-plugin 看类没变就不重写 jar，spring-boot-maven-plugin
        也跳过已经 repackage 过的产物，于是上一次那个"全驱动"的 fat jar 原地留下来，
        -Ddrivers 看起来完全没生效——四个 profile 量出来会是同一个大小。

        drivers=none 的外挂方式（PropertiesLauncher 而不是默认的 JarLauncher）：
          java -cp app.jar -Dloader.path=/opt/jdbc \
               org.springframework.boot.loader.launch.PropertiesLauncher

        这里刻意不用 activeByDefault：只要命令行上激活了任何一个 profile，
        activeByDefault 的那个就会被静默关掉，于是「-Ddrivers 没写却少了驱动」。
        用 !drivers 做条件是确定的，也能和其他 profile 共存。
    -->
    <profiles>
        <profile>
            <id>drivers-all</id>
            <activation>
                <property>
                    <name>!drivers</name>
                </property>
            </activation>
            <dependencies>
                <dependency>
                    <groupId>com.oracle.database.jdbc</groupId>
                    <artifactId>ojdbc11</artifactId>
                    <version>${oracle.jdbc.version}</version>
                    <scope>runtime</scope>
                </dependency>
                <!-- Oracle 的 NLS/字符集支持，缺了它非 ASCII 数据会乱码 -->
                <dependency>
                    <groupId>com.oracle.database.nls</groupId>
                    <artifactId>orai18n</artifactId>
                    <version>${oracle.jdbc.version}</version>
                    <scope>runtime</scope>
                </dependency>
                <dependency>
                    <groupId>com.mysql</groupId>
                    <artifactId>mysql-connector-j</artifactId>
                    <version>${mysql.jdbc.version}</version>
                    <scope>runtime</scope>
                </dependency>
                <dependency>
                    <groupId>org.postgresql</groupId>
                    <artifactId>postgresql</artifactId>
                    <version>${postgresql.jdbc.version}</version>
                    <scope>runtime</scope>
                </dependency>
                <dependency>
                    <groupId>com.microsoft.sqlserver</groupId>
                    <artifactId>mssql-jdbc</artifactId>
                    <version>${sqlserver.jdbc.version}</version>
                    <scope>runtime</scope>
                </dependency>
                <dependency>
                    <groupId>org.xerial</groupId>
                    <artifactId>sqlite-jdbc</artifactId>
                    <version>${sqlite.jdbc.version}</version>
                    <scope>runtime</scope>
                </dependency>
                <dependency>
                    <groupId>com.ibm.db2</groupId>
                    <artifactId>jcc</artifactId>
                    <version>${db2.jdbc.version}</version>
                    <scope>runtime</scope>
                </dependency>
            </dependencies>
        </profile>

        <!-- 只保留可自由分发的驱动：Oracle / SQL Server / DB2 的 jar 有再分发限制 -->
        <profile>
            <id>drivers-oss</id>
            <activation>
                <property>
                    <name>drivers</name>
                    <value>oss</value>
                </property>
            </activation>
            <dependencies>
                <dependency>
                    <groupId>com.mysql</groupId>
                    <artifactId>mysql-connector-j</artifactId>
                    <version>${mysql.jdbc.version}</version>
                    <scope>runtime</scope>
                </dependency>
                <dependency>
                    <groupId>org.postgresql</groupId>
                    <artifactId>postgresql</artifactId>
                    <version>${postgresql.jdbc.version}</version>
                    <scope>runtime</scope>
                </dependency>
                <dependency>
                    <groupId>org.xerial</groupId>
                    <artifactId>sqlite-jdbc</artifactId>
                    <version>${sqlite.jdbc.version}</version>
                    <scope>runtime</scope>
                </dependency>
            </dependencies>
        </profile>

        <!-- 容器化部署的常见形态：只连一两个网络库，sqlite 的全平台原生库纯属负担 -->
        <profile>
            <id>drivers-minimal</id>
            <activation>
                <property>
                    <name>drivers</name>
                    <value>minimal</value>
                </property>
            </activation>
            <dependencies>
                <dependency>
                    <groupId>org.postgresql</groupId>
                    <artifactId>postgresql</artifactId>
                    <version>${postgresql.jdbc.version}</version>
                    <scope>runtime</scope>
                </dependency>
                <dependency>
                    <groupId>com.mysql</groupId>
                    <artifactId>mysql-connector-j</artifactId>
                    <version>${mysql.jdbc.version}</version>
                    <scope>runtime</scope>
                </dependency>
            </dependencies>
        </profile>

        <!--
            不打任何外部驱动。只留 H2，因为 application-test.yml 是随包发布的 profile，
            少了它 -Dspring.profiles.active=test 会直接起不来。
        -->
        <profile>
            <id>drivers-none</id>
            <activation>
                <property>
                    <name>drivers</name>
                    <value>none</value>
                </property>
            </activation>
        </profile>
    </profiles>

    <build>
        <plugins>
            <!--
                只读运维面板的前端构建（Vite + React 19 + Meta Astryx）。

                ── 为什么绑在 generate-resources ──
                产物必须在 surefire 之前就位：WebUiTest 起完整 Spring 上下文去要 / 与
                /assets/index-<hash>.js，静态资源那时是从 target/classes/static 解析的。
                绑到 prepare-package 就晚了，测试会在一个空 static 上跑。
                generate-resources 又早于 process-resources，所以资源拷贝不会覆盖或清掉产物
                （src/main/resources/static 已经删掉了，源侧不再有同名目录）。

                ── 为什么用插件自带的 node，而不是机器上的 ──
                构建结果不能取决于开发者机器上恰好装了哪个 node。install-node-and-npm
                会把 node/npm 装进 workingDirectory（src/main/frontend/node/），
                刻意不放 target/：放 target 的话每次 clean 都要重新联网下 node，
                而 `-o` 离线构建就再也过不去了。node/ 已进 .gitignore。

                ── npm ci 而不是 npm install ──
                ci 严格按 package-lock.json 装，lock 与 package.json 不一致时直接失败。
                install 会就地改写 lock——那等于把"钉死版本"这件事悄悄取消掉。
            -->
            <plugin>
                <groupId>com.github.eirslett</groupId>
                <artifactId>frontend-maven-plugin</artifactId>
                <version>${frontend-maven-plugin.version}</version>
                <configuration>
                    <workingDirectory>src/main/frontend</workingDirectory>
                    <skip>${frontend.skip}</skip>
                </configuration>
                <executions>
                    <execution>
                        <id>frontend-install-node-and-npm</id>
                        <phase>generate-resources</phase>
                        <goals>
                            <goal>install-node-and-npm</goal>
                        </goals>
                        <configuration>
                            <nodeVersion>${frontend.node.version}</nodeVersion>
                            <npmVersion>${frontend.npm.version}</npmVersion>
                        </configuration>
                    </execution>
                    <execution>
                        <id>frontend-npm-ci</id>
                        <phase>generate-resources</phase>
                        <goals>
                            <goal>npm</goal>
                        </goals>
                        <configuration>
                            <arguments>ci --no-audit --no-fund</arguments>
                        </configuration>
                    </execution>
                    <execution>
                        <id>frontend-npm-run-build</id>
                        <phase>generate-resources</phase>
                        <goals>
                            <goal>npm</goal>
                        </goals>
                        <configuration>
                            <arguments>run build</arguments>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>

            <!-- 跨模块汇总覆盖率：app 依赖全部模块，report-aggregate 在这里才看得全 -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>jacoco-report-aggregate</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>report-aggregate</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
