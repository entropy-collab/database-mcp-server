<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.entropy.agent</groupId>
        <artifactId>database-mcp-parent</artifactId>
        <version>0.1.4</version>
    </parent>

    <!--
        artifactId 刻意与目录名不同：可执行 jar 的名字保持 database-mcp-server-<version>.jar，
        Docker、README 与既有部署脚本引用的都是这个名字，不因为内部模块化而改变。
    -->
    <artifactId>database-mcp-server</artifactId>
    <name>Entropy Database MCP Server (app)</name>
    <description>装配层：启动类、Spring 配置、application.yml 与 JDBC 驱动，产出可执行 jar</description>

    <dependencies>
        <dependency>
            <groupId>com.entropy.agent</groupId>
            <artifactId>database-mcp-tools</artifactId>
        </dependency>

        <!-- 工具暴露测试夹具（SampleTools / FixedObjectProvider） -->
        <dependency>
            <groupId>com.entropy.agent</groupId>
            <artifactId>database-mcp-tools</artifactId>
            <type>test-jar</type>
            <scope>test</scope>
        </dependency>

        <!--
            JDBC 驱动只在这里：没有任何代码直接引用驱动类，它们纯粹要求出现在运行期
            classpath 上。放在 app 意味着 core/infra/features 可以在不拖驱动的前提下被复用。
        -->
        <dependency>
            <groupId>com.oracle.database.jdbc</groupId>
            <artifactId>ojdbc11</artifactId>
            <version>${oracle.jdbc.version}</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>com.oracle.database.nls</groupId>
            <artifactId>orai18n</artifactId>
            <version>${oracle.jdbc.version}</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <version>${mysql.jdbc.version}</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <version>${postgresql.jdbc.version}</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>com.microsoft.sqlserver</groupId>
            <artifactId>mssql-jdbc</artifactId>
            <version>${sqlserver.jdbc.version}</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.xerial</groupId>
            <artifactId>sqlite-jdbc</artifactId>
            <version>${sqlite.jdbc.version}</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>com.ibm.db2</groupId>
            <artifactId>jcc</artifactId>
            <version>${db2.jdbc.version}</version>
            <scope>runtime</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>

            <!-- 跨模块汇总覆盖率：app 依赖全部模块，report-aggregate 在这里才看得全 -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>jacoco-report-aggregate</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>report-aggregate</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
