<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.0</version>
    </parent>

    <groupId>com.entropy.agent</groupId>
    <artifactId>database-mcp-parent</artifactId>
    <version>0.1.4</version>
    <packaging>pom</packaging>
    <name>Entropy Database MCP Server (parent)</name>
    <description>Oracle Database MCP Server</description>

    <!--
        分层聚合。模块依赖方向只允许自下而上，Maven 会在编译期强制这一点：
            core     ← 无出边的内核：exception / domain / properties / session / cache / util
            infra    ← core：dialect / audit / security / monitor / repository / byok
            features ← infra：facade / backup / etl / cdc / catalog / lineage / optimizer /
                              quality / gateway / stream
            tools    ← features：tools / aop / extension / controller（MCP 暴露层）
            app      ← tools：DatabaseMcpApplication / config / init + application.yml
        包名一律保持 com.entropy.database.mcp.*，不随模块改名——改包名会把"移动"变成
        "重写"，review 无法进行。
    -->
    <modules>
        <module>database-mcp-core</module>
        <module>database-mcp-infra</module>
        <module>database-mcp-features</module>
        <module>database-mcp-tools</module>
        <module>database-mcp-app</module>
    </modules>

    <properties>
        <java.version>25</java.version>
        <oracle.jdbc.version>23.26.3.0.0</oracle.jdbc.version>
        <mysql.jdbc.version>26.7.0</mysql.jdbc.version>
        <postgresql.jdbc.version>42.7.13</postgresql.jdbc.version>
        <!-- 只用 GA 版本：13.5.x 目前仅有 -preview，故停在 13.4.0；Java 25 运行时取 jre11 分类器 -->
        <sqlserver.jdbc.version>13.4.0.jre11</sqlserver.jdbc.version>
        <sqlite.jdbc.version>3.53.4.0</sqlite.jdbc.version>
        <spring-ai.version>2.0.1</spring-ai.version>
        <archunit.version>1.5.0</archunit.version>
        <jacoco.version>0.8.15</jacoco.version>
        <db2.jdbc.version>12.1.5.0</db2.jdbc.version>
        <guava.version>33.7.1-jre</guava.version>
        <caffeine.version>3.2.4</caffeine.version>
        <jsqlparser.version>5.3</jsqlparser.version>
        <opentelemetry.version>1.65.0</opentelemetry.version>
        <opentelemetry-instrumentation.version>2.31.1-alpha</opentelemetry-instrumentation.version>
    </properties>

    <repositories>
        <repository>
            <id>central</id>
            <name>Maven Central</name>
            <url>https://repo1.maven.org/maven2</url>
        </repository>
        <repository>
            <id>aliyun</id>
            <name>Alibaba Cloud Mirror</name>
            <url>https://maven.aliyun.com/repository/public</url>
        </repository>
    </repositories>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.ai</groupId>
                <artifactId>spring-ai-bom</artifactId>
                <version>${spring-ai.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- 本仓库自己的模块，子模块引用时不再写版本号 -->
            <dependency>
                <groupId>com.entropy.agent</groupId>
                <artifactId>database-mcp-core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.entropy.agent</groupId>
                <artifactId>database-mcp-infra</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.entropy.agent</groupId>
                <artifactId>database-mcp-features</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.entropy.agent</groupId>
                <artifactId>database-mcp-tools</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.entropy.agent</groupId>
                <artifactId>database-mcp-tools</artifactId>
                <version>${project.version}</version>
                <type>test-jar</type>
                <scope>test</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <!--
        这些三方依赖对所有模块可见。之所以不按模块收窄：模块化这一步的目标是把"分层"
        变成编译期约束，一次改动只做一件事。依赖收窄是独立的后续工作，收窄错了会以
        NoClassDefFoundError 的形式在运行期才暴露，不该和大规模文件移动混在一个提交里。
        例外是 JDBC 驱动：没有任何代码直接引用驱动类，它们是纯 runtime，只留在 app。
    -->
    <dependencies>
        <!-- Spring AI MCP Server (WebMVC) -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-mcp-server-webmvc</artifactId>
        </dependency>

        <!-- Spring JDBC + HikariCP -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jdbc</artifactId>
        </dependency>

        <!-- Jackson -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>

        <!-- H2：dialect 包里有 H2Dialect，主代码编译期就需要 -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
        </dependency>

        <!-- Spring Boot Actuator -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- Micrometer Prometheus Registry -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
        </dependency>

        <!-- Spring Security OAuth2 Resource Server -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-oauth2-resource-server</artifactId>
        </dependency>

        <!-- Spring Security -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>

        <!-- Spring AOP -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-aspectj</artifactId>
        </dependency>

        <!-- Guava for BloomFilter -->
        <dependency>
            <groupId>com.google.guava</groupId>
            <artifactId>guava</artifactId>
            <version>${guava.version}</version>
        </dependency>

        <!-- Caffeine Cache -->
        <dependency>
            <groupId>com.github.ben-manes.caffeine</groupId>
            <artifactId>caffeine</artifactId>
            <version>${caffeine.version}</version>
        </dependency>

        <!-- JSQLParser for SQL validation -->
        <dependency>
            <groupId>com.github.jsqlparser</groupId>
            <artifactId>jsqlparser</artifactId>
            <version>${jsqlparser.version}</version>
        </dependency>

        <!-- OpenTelemetry -->
        <dependency>
            <groupId>io.opentelemetry</groupId>
            <artifactId>opentelemetry-api</artifactId>
            <version>${opentelemetry.version}</version>
        </dependency>
        <dependency>
            <groupId>io.opentelemetry</groupId>
            <artifactId>opentelemetry-sdk</artifactId>
            <version>${opentelemetry.version}</version>
        </dependency>
        <dependency>
            <groupId>io.opentelemetry</groupId>
            <artifactId>opentelemetry-exporter-otlp</artifactId>
            <version>${opentelemetry.version}</version>
        </dependency>
        <dependency>
            <groupId>io.opentelemetry.instrumentation</groupId>
            <artifactId>opentelemetry-jdbc</artifactId>
            <version>${opentelemetry-instrumentation.version}</version>
        </dependency>

        <!-- Spring Boot test -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- ArchUnit: architecture rules (evaluated warn-only, see ArchitectureRulesTest) -->
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit-junit5</artifactId>
            <version>${archunit.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!--
                JaCoCo coverage. Measurement only: no `check` goal and no thresholds, so coverage
                can never break the build. 每个模块产出自己的 exec 与报告；跨模块汇总报告由
                app 模块的 report-aggregate 生成（它依赖全部模块）。
            -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>${jacoco.version}</version>
                <executions>
                    <execution>
                        <id>jacoco-prepare-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>jacoco-report</id>
                        <phase>test</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
