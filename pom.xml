<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.0</version>
    </parent>

    <groupId>com.entropy.agent</groupId>
    <artifactId>database-mcp-parent</artifactId>
    <version>0.6.0</version>
    <packaging>pom</packaging>
    <name>Entropy Database MCP Server (parent)</name>
    <description>Oracle Database MCP Server</description>

    <!--
        分层聚合。模块依赖方向只允许自下而上，Maven 会在编译期强制这一点：
            contract ← 零依赖的叶子：ErrorCode + McpToolException 家族
            core     ← contract：domain / properties / session / cache / util
            dialect  ← contract：DatabaseDialect 契约 + DialectProvider SPI + 8 个内置方言
            infra    ← core + dialect：audit / security / monitor / repository / byok
            features ← infra：facade / backup / etl / cdc / catalog / lineage / optimizer /
                              quality / gateway / stream
            tools    ← features：tools / aop / extension / controller（MCP 暴露层）
            app      ← tools：DatabaseMcpApplication / config / init + application.yml
        包名一律保持 com.entropy.database.mcp.*，不随模块改名——改包名会把"移动"变成
        "重写"，review 无法进行。

        dialect 从 infra 里独立出来是为了给第三方方言一个不含连接池的编译期契约，理由写在
        database-mcp-dialect/pom.xml 里。它同时把方向反过来钉住了：方言编译不到 HikariCP、
        spring-jdbc 和 byok 包，想在方言里偷偷拿连接会编译失败。

        contract 是 0.4.0 加的，与 core 并列而不是在 core 之下的一段：dialect 现在只依赖
        contract，不再经由 core 吃到 spring-boot / jackson / guava。理由与实测数据写在
        database-mcp-contract/pom.xml 里。
    -->
    <modules>
        <module>database-mcp-contract</module>
        <module>database-mcp-core</module>
        <module>database-mcp-dialect</module>
        <module>database-mcp-infra</module>
        <module>database-mcp-features</module>
        <module>database-mcp-tools</module>
        <module>database-mcp-app</module>
    </modules>

    <properties>
        <java.version>25</java.version>
        <!--
            JDK 23 起 javac 默认关闭"隐式注解处理"：光把 spring-boot-configuration-processor
            放进 classpath 不会生成任何东西，也不会报错，只是静默什么都不做。必须显式打开，
            否则 spring-configuration-metadata.json 永远不会出现。
        -->
        <maven.compiler.proc>full</maven.compiler.proc>
        <oracle.jdbc.version>23.26.3.0.0</oracle.jdbc.version>
        <mysql.jdbc.version>26.7.0</mysql.jdbc.version>
        <postgresql.jdbc.version>42.7.13</postgresql.jdbc.version>
        <!-- 只用 GA 版本：13.5.x 目前仅有 -preview，故停在 13.4.0；Java 25 运行时取 jre11 分类器 -->
        <sqlserver.jdbc.version>13.4.0.jre11</sqlserver.jdbc.version>
        <sqlite.jdbc.version>3.53.4.0</sqlite.jdbc.version>
        <spring-ai.version>2.0.1</spring-ai.version>
        <archunit.version>1.5.0</archunit.version>
        <jacoco.version>0.8.15</jacoco.version>
        <db2.jdbc.version>12.1.5.0</db2.jdbc.version>
        <guava.version>33.7.1-jre</guava.version>
        <caffeine.version>3.2.4</caffeine.version>
        <jsqlparser.version>5.4</jsqlparser.version>
    </properties>

    <repositories>
        <!--
            随仓库分发的 facet 授权内核（libs/ 下按 Maven 目录布局摆放，三个 jar 合计约 150KB）。

            为什么要有这个仓库：facet 是本项目之外的另一个工程，尚未发布到任何公共仓库。
            在此之前 database-mcp-infra 依赖的是本机 mvn install 出来的 0.1.0-SNAPSHOT——
            结果是"只有作者那台机器能构建"：GitHub Actions 与任何 clone 者都会在
            database-mcp-infra 上报 Could not find artifact io.github.yaotj:facet-core。

            为什么版本号带 commit sha（0.1.0-c9642a1 = facet 仓库的 HEAD）：
            这批 jar 是 snapshot 构建，不是正式的 0.1.0。写成 0.1.0 会在 facet 真正发布
            0.1.0 时撞坐标，且两者内容不同。带 sha 的限定符排在 0.1.0 之前，将来 facet
            发到 Central 后直接把版本改成 0.1.0 即是一次自然升级。

            libs/ 下的三份 pom 是手写的、不带 <parent>：facet 上游 parent 会引入 junit /
            testcontainers / jackson 三个 BOM，消费方不需要也不该被迫解析它们。

            更新方式（facet 改动后）：
              cd ../../facet && mvn install -DskipTests
              然后把新 jar 拷进 libs/ 对应目录、改坐标里的 sha、同步 database-mcp-infra 的版本号。
            这是刻意选择的取舍——二进制入库换"任何人 clone 下来就能构建"。
        -->
        <repository>
            <id>vendored-libs</id>
            <name>Vendored facet artifacts (in-tree)</name>
            <url>file://${maven.multiModuleProjectDirectory}/libs</url>
            <releases>
                <enabled>true</enabled>
            </releases>
            <snapshots>
                <enabled>false</enabled>
            </snapshots>
        </repository>
        <repository>
            <id>central</id>
            <name>Maven Central</name>
            <url>https://repo1.maven.org/maven2</url>
        </repository>
        <repository>
            <id>aliyun</id>
            <name>Alibaba Cloud Mirror</name>
            <url>https://maven.aliyun.com/repository/public</url>
        </repository>
    </repositories>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.ai</groupId>
                <artifactId>spring-ai-bom</artifactId>
                <version>${spring-ai.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!--
                Spring Boot 与 Spring AI 的 BOM 没有覆盖到的三方件，版本在这里定一次，
                子模块只写 groupId/artifactId。
            -->
            <dependency>
                <groupId>com.google.guava</groupId>
                <artifactId>guava</artifactId>
                <version>${guava.version}</version>
            </dependency>
            <dependency>
                <groupId>com.github.ben-manes.caffeine</groupId>
                <artifactId>caffeine</artifactId>
                <version>${caffeine.version}</version>
            </dependency>
            <dependency>
                <groupId>com.github.jsqlparser</groupId>
                <artifactId>jsqlparser</artifactId>
                <version>${jsqlparser.version}</version>
                <!--
                    jsqlparser 5.3 把它自己跑基准用的 jmh-core 声明成 compile 依赖，于是
                    JMH + jopt-simple + commons-math3 三个 jar 会流进每一个依赖它的模块、
                    进可执行 jar，也进第三方方言作者的编译期 classpath。仓库里没有任何一处
                    import org.openjdk.jmh —— 基准测试框架不是运行时依赖。

                    5.4 上游已经把它改成 test 作用域，所以这条排除在当前版本上是空操作。保留是
                    当棘轮用：作用域曾经错过一次，排除留着，下次错了也不会再漏进来，成本为零。

                    排除写在 dependencyManagement 而不是各模块：core / infra / features / app
                    都直接声明了 jsqlparser，写在 core 只能管住 core 自己那一条边。
                -->
                <exclusions>
                    <exclusion>
                        <groupId>org.openjdk.jmh</groupId>
                        <artifactId>jmh-core</artifactId>
                    </exclusion>
                </exclusions>
            </dependency>

            <!-- 本仓库自己的模块，子模块引用时不再写版本号 -->
            <dependency>
                <groupId>com.entropy.agent</groupId>
                <artifactId>database-mcp-contract</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.entropy.agent</groupId>
                <artifactId>database-mcp-core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.entropy.agent</groupId>
                <artifactId>database-mcp-dialect</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.entropy.agent</groupId>
                <artifactId>database-mcp-infra</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.entropy.agent</groupId>
                <artifactId>database-mcp-features</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.entropy.agent</groupId>
                <artifactId>database-mcp-tools</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.entropy.agent</groupId>
                <artifactId>database-mcp-tools</artifactId>
                <version>${project.version}</version>
                <type>test-jar</type>
                <scope>test</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <!--
        父 POM 只保留"每个模块都真的用到"的依赖，也就是测试基座。三方运行期依赖一律下沉到
        直接使用它的模块，理由是：依赖写在父 POM 里，Maven 就无法帮我们发现越层引用——
        infra 误用 spring-ai、core 误用 spring-jdbc 都能编过。下沉之后，模块的 pom 就是
        它的对外契约，core/infra/features 可以被单独复用而不拖 MCP、驱动、Web 那一整套。
    -->
    <dependencies>
        <!-- Spring Boot test -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- ArchUnit: architecture rules (evaluated warn-only, see ArchitectureRulesTest) -->
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit-junit5</artifactId>
            <version>${archunit.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!--
                JaCoCo coverage. Measurement only: no `check` goal and no thresholds, so coverage
                can never break the build. 每个模块产出自己的 exec 与报告；跨模块汇总报告由
                app 模块的 report-aggregate 生成（它依赖全部模块）。
            -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>${jacoco.version}</version>
                <executions>
                    <execution>
                        <id>jacoco-prepare-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>jacoco-report</id>
                        <phase>test</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
