<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.entropy.agent</groupId>
        <artifactId>database-mcp-parent</artifactId>
        <version>0.1.4</version>
    </parent>

    <artifactId>database-mcp-core</artifactId>
    <name>Entropy Database MCP Core</name>
    <description>内核层：异常、领域模型、配置属性、会话、缓存与工具方法，不依赖任何本仓库模块</description>

    <!--
        core 刻意不依赖 spring-jdbc / spring-web / MCP SDK：它不碰数据库连接，也不知道自己
        被 MCP 暴露。spring-boot 只为 @ConfigurationProperties 与 Binder 而来，它顺带带入
        spring-core / spring-context（@Component 等 stereotype 注解在这里）。
    -->
    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot</artifactId>
        </dependency>
        <!--
            只要 slf4j 门面，不要 spring-boot-starter（它会把 logback 钉进来）。日志实现
            由最终应用决定，core 作为库不该替它选。
        -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
        <!-- ValidationUtils 用 JSQLParser 做 WHERE 片段的白名单校验 -->
        <dependency>
            <groupId>com.github.jsqlparser</groupId>
            <artifactId>jsqlparser</artifactId>
        </dependency>
        <dependency>
            <groupId>com.github.ben-manes.caffeine</groupId>
            <artifactId>caffeine</artifactId>
        </dependency>
        <!-- BloomFilter -->
        <dependency>
            <groupId>com.google.guava</groupId>
            <artifactId>guava</artifactId>
        </dependency>

        <!--
            为 16 个 @ConfigurationProperties 类生成 META-INF/spring-configuration-metadata.json：
            entropy.mcp.* 有一百多个键，没有元数据时 IDE 补全、/actuator/configprops 的说明、
            以及"键写错了"的提示全都拿不到。纯注解处理器，optional 保证不传递给下游模块。
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-configuration-processor</artifactId>
            <optional>true</optional>
        </dependency>
    </dependencies>

</project>
